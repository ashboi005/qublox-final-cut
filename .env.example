# apps/server (Elysia). Copy to .env and adjust.
DATABASE_URL=postgres://qublox:qublox@localhost:5433/qublox
PORT=8787
# Optional: if set, runs must include this passcode to be posted (keeps randoms off the board).
CREW_PASSCODE=
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# apps/game (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8787
