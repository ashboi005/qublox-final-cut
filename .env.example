# apps/server (Elysia). Copy to .env and adjust. In Coolify, set these in the server resource's env instead.
DATABASE_URL=postgres://qublox:qublox@localhost:5433/qublox
PORT=8787
# Comma-separated origins allowed to call the API (the game's URL). Also Better Auth's trusted origins.
CORS_ORIGINS=http://localhost:5173
# Better Auth. Secret is required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The API's public URL (OAuth callbacks land on <this>/api/auth/callback/<provider>).
BETTER_AUTH_URL=http://localhost:8787
# Optional sign-in providers; a button appears in the game only when both id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only if the game and API are on unrelated domains (not sibling subdomains): 1 = SameSite=None cookies.
CROSS_SITE_COOKIES=

# apps/game (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8787
